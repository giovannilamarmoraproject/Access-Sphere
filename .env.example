# ==============================================================================
# 🎡 Access-Sphere - Environment Variables Template
# Copy this file to .env and configure the variables for your environment
# ==============================================================================

# --- Server & Core Configuration ---
APP_ENV=Production
PORT=8080
COOKIE_DOMAIN=localhost
SPRING_PROFILES_ACTIVE=deploy
TZ=Europe/Rome
APP_DOMAIN=access-sphere.giovannilamarmora.com
CODEC_MAX_IN_MEMORY_SIZE=20MB

# --- Database Configuration (MySQL / MariaDB) ---
DATABASE_JDBC_URL=jdbc:mysql://localhost:3306
DATABASE_NAME=access_sphere
DATABASE_USERNAME=root
DATABASE_PASSWORD=your_secure_db_password

# --- Security, Encryption & Initial Seed ---
# AES 256-bit symmetric encryption key (32 characters) for OAuth secrets and sensitive storage
AES_KEY=your_32_character_aes_secret_key!
# Technical Administrator credentials for initial database bootstrap
ADMIN_USERNAME=tech_admin
ADMIN_PASSWORD=your_secure_tech_password
ADMIN_EMAIL=admin@accesssphere.local
# Optional JWT Secret for administrative tokens. If left blank, a random 256-bit key is generated at startup
ADMIN_JWT_SECRET=

# --- Native SMTP Mail Dispatcher ---
# SMTP server settings for transactional emails (password reset, email verification, test emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SERVER_EMAIL=admin@access-sphere.com
SERVER_TOKEN=your_smtp_app_password_or_token
# Comma-separated whitelist of allowed 'From' addresses (defaults to SERVER_EMAIL if not set)
SENDER_EMAILS=admin@access-sphere.com

# --- Logging & Monitoring ---
LOGGING_LEVEL=INFO
LOGBACK_FILE=classpath:logback-spring.xml
# Google Cloud Platform (Optional)
GCLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# --- CORS (Cross-Origin Resource Sharing) ---
CORS_ENABLED=true
CORS_NOT_FILTER=*swagger*,*api-docs*,*webjars*
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_HEADERS=Origin, Content-Type, Accept, Authorization, Location, Trace-ID, Span-ID, Parent-ID, Registration-Token, Session-ID, Redirect-Uri
CORS_ALLOW_CREDENTIALS=true

# --- Docker & CI/CD Deployment ---
DOCKER_REPOSITORY=giovannilamarmora/access-sphere
APP_VERSION=latest
