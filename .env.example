# ==============================================================================
# 🎡 AccessSphere - Environment Variables Template
# Copy this file to .env and configure the variables for your environment
# ==============================================================================

# --- Server & Core Configuration ---
APP_ENV=Production
PORT=8080
COOKIE_DOMAIN=localhost
SPRING_PROFILES_ACTIVE=deploy
TZ=Europe/Rome

# --- Database Configuration (MySQL / MariaDB) ---
DATABASE_JDBC_URL=jdbc:mysql://localhost:3306
DATABASE_NAME=access_sphere
DATABASE_USERNAME=root
DATABASE_PASSWORD=your_secure_db_password

# --- Security & Encryption ---
# AES 256-bit symmetric encryption key for credentials and secrets
AES_KEY=your_32_character_aes_secret_key!
# Technical user credentials & Application Init
TECH_USERNAME=tech_admin
TECH_PASSWORD=your_secure_tech_password
TECH_CLIENT_ID=ACCESS-SPHERE-TECH
TECH_EMAIL=admin@accesssphere.local

# --- Logging & Monitoring ---
LOGGING_LEVEL=INFO
LOGBACK_FILE=classpath:logback-spring.xml
# Google Cloud Platform (Optional)
GCLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Strapi CMS Integration (Optional / Legacy Bridge) ---
STRAPI_ACTIVE=false
STRAPI_BASE_URL=https://strapi.example.com
STRAPI_AUTH_TOKEN=your_strapi_bearer_token

# --- CORS (Cross-Origin Resource Sharing) ---
CORS_ENABLED=true
CORS_NOT_FILTER=**/swagger-ui/**,/api-docs,**/api-docs/**
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_HEADERS=Origin, Content-Type, Accept, Authorization, Location, Trace-ID, Span-ID, Parent-ID, Registration-Token, Session-ID, Redirect-Uri
CORS_ALLOW_CREDENTIALS=true

# --- Docker & CI/CD Deployment ---
DOCKER_REPOSITORY=giovannilamarmora/access-sphere
APP_VERSION=latest
